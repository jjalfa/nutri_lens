rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /meals/{mealId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.dateKey is string
          && request.resource.data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.dish_name is string
          && request.resource.data.dish_name.size() > 0
          && request.resource.data.total_calories is number
          && request.resource.data.total_calories >= 0
          && request.resource.data.total_protein_g is number
          && request.resource.data.total_protein_g >= 0
          && request.resource.data.total_carbs_g is number
          && request.resource.data.total_carbs_g >= 0
          && request.resource.data.total_fat_g is number
          && request.resource.data.total_fat_g >= 0
          && request.resource.data.items is list;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}